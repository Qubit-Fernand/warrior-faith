   import flash.display.*;
   import flash.events.*;
   import flash.geom.*;
   import flash.net.*;
   
   public class TempData extends MovieClip
   {
      
      private static var infoArr:Array;
      
      method
         name ""
         returns null
         
         body
            maxstack 9
            localcount 1
            initscopedepth 9
            maxscopedepth 10
            
            code
               getlocal0
               pushscope
               findproperty QName(PrivateNamespace("src:TempData"),"infoArr")
               pushstring "1.游戏画面大改版,变更了新的游戏登录图,加载图,世界地图,新村庄图片,新手形象,2个发型调整,NPC形象等"
               pushstring "2.新增悬赏怪物LV6：毁灭者-初号机"
               pushstring "3.击杀点商城新增力量印章制作书，力量印章碎片由【毁灭者—初号机】掉落"
               pushstring "4.增加2个怪物图鉴:毁灭能源,毁灭者—初号机"
               pushstring "5.降低开启下一等级悬赏怪条件,现在只需要击败10次悬赏怪开启下一等级悬赏怪了"
               pushstring "6.悬赏称号领取也只需要击败10次对应悬赏怪即可。"
               pushstring "7.增加新称号: 悬赏猎人LV6"
               pushstring "8.仓库功能转移到NPC“探险家—艾路斯”上"
               newarray 8
               setproperty QName(PrivateNamespace("src:TempData"),"infoArr")
               returnvoid
            end ; code
         end ; body
      end ; method
      
