                                                                                 public function 复制存档信息() : *
                                                                                 {
                                                                                    trait method QName(PackageNamespace(""),"复制存档信息")
                                                                                       dispid 0
                                                                                       method
                                                                                          name null
                                                                                          returns null
                                                                                          
